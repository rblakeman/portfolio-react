{
    "name": "server",
    "version": "1.0.0",
    "description": "Simple static asset server",
    "main": "dist/index.js",
    "scripts": {
        "build": "npx tsc && npm run build:assets",
        "build:assets": "cp -r public/ dist/public/",
        "start": "node dist/index.js",
        "dev": "concurrently \"npm run build && npx tsc --watch\" \"nodemon -q dist/index.js\"",
        "typecheck": "tsc --noEmit"
    },
    "author": "Ryan Blakeman",
    "license": "ISC",
    "dependencies": {
        "cors": "^2.8.5",
        "express": "^5.2.0"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.3",
        "@types/node": "^22.18.12",
        "concurrently": "^9.2.1",
        "nodemon": "^3.1.10",
        "typescript": "^5.9.3"
    }
}
