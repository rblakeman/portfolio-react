{
    "name": "portfolio-react",
    "version": "0.3.0",
    "private": true,
    "homepage": "https://ryanblakeman.com",
    "type": "module",
    "scripts": {
        ":i": "npm run init",
        ":s": "npm run start",
        ":v": "npm run verify",
        "init": "npm ci && cd server && npm ci",
        "start": "concurrently \"npm run dev:ui\" \"npm run dev:server\"",
        "dev:ui": "vite",
        "dev:server": "cd server && npm run dev",
        "build": "npm run build:ui && npm run build:server",
        "build:ui": "tsc -b && vite build",
        "build:server": "cd server && npm run build",
        "lint": "npm run lint:eslint && npm run lint:prettier",
        "lint:eslint": "eslint .",
        "lint:prettier": "prettier . --check",
        "format": "npm run format:eslint && npm run format:prettier",
        "format:eslint": "eslint . --fix",
        "format:prettier": "prettier . --write",
        "typecheck": "tsc --noEmit",
        "predeploy": "npm run build:ui",
        "deploy": "gh-pages -d dist",
        "verify": "npm run format && npm run lint && npm run typecheck && npm run verify:server",
        "verify:server": "cd server && npm run typecheck",
        "verify:ci": "npm run verify && npm run build"
    },
    "engines": {
        "node": "^24.12.0"
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@fortawesome/fontawesome-svg-core": "^7.2.0",
        "@fortawesome/free-brands-svg-icons": "^7.2.0",
        "@fortawesome/free-solid-svg-icons": "^7.2.0",
        "@fortawesome/react-fontawesome": "^3.3.1",
        "@mui/icons-material": "^9.0.1",
        "@mui/material": "^9.0.1",
        "react": "^19.2.7",
        "react-dom": "^19.2.7"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.13.1",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.2.0",
        "concurrently": "^10.0.3",
        "eslint": "^10.4.1",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "gh-pages": "^6.3.0",
        "globals": "^17.6.0",
        "prettier": "^3.8.3",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.60.1",
        "vite": "npm:rolldown-vite@7.1.14"
    },
    "overrides": {
        "vite": "npm:rolldown-vite@7.1.14"
    }
}
